# Kopieer dit bestand naar .env en vul de twee waarden in.
# .env staat in .gitignore en gaat dus nooit mee naar GitHub.
#
# Allebei te vinden in Supabase: Project Settings -> API Keys.
#
# De sleutel hieronder is de PUBLIEKE sleutel (publishable / anon). Die mag
# in de browser staan; wat je beschermt is row level security, niet deze
# sleutel. De secret key (service_role) hoort hier NIET in -- die gaat langs
# alle policies heen.

PUBLIC_SUPABASE_URL=https://jouwproject.supabase.co
PUBLIC_SUPABASE_KEY=
